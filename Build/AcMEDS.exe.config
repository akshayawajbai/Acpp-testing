<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="app.dataaccess" type="Bosco.DAO.Configuration.DatabaseHandler, Bosco.DAO"/>
  </configSections>

  <connectionStrings>
    <!-- <add name="AppConnectionString" connectionString="server=192.168.1.6; database=admin_portal; uid=portal;pwd=portal#; charset=utf8; pooling=false" providerName="MySQL.Data.MySqlClient"/>-->
    <add name="AppConnectionString" connectionString="server=localhost;database=admin_portal;port=3307;uid=root;pwd=acperproot; charset=utf8; pooling=false" providerName="MySQL.Data.MySqlClient"/>
  </connectionStrings>


  <!--This value should be mapped in app.dataaccess to identify what type of Database Handler-->
  <!--It has to be declared as Enum Type in Bosco.Utility.EnumCommand.AppSettingName-->
  <appSettings>
    <!--<add key="DatabaseProvider" value="SQLServer"/>-->
    <add key="DatabaseProvider" value="MySQL"/>
    <add key="HOSQLAdapter" value="Bosco.HOSQL.SQLAdapter,Bosco.HOSQL"/>
    <!--For Data Synchronization -->
    <add key="DataSyncInterval" value="1"/>
    <!--In Minutes -->
    <add key="DataSyncLocation" value="D:\datasync"/>
    <add key="DataSyncFailedVoucherPath" value="E:\FailedVouchers\Fail\Pass"/>
    <add key="DefaultSenderEmailId" value="acmeerpportal@gmail.com"/>
    <add key="DefaultBCCEmailId" value="acmeerp@boscosofttech.com, alex@boscosofttech.com" />
  </appSettings>

  <!--Which is defined in configSections to be implemented here to access Data object (SQL Server/MySQL/....)-->
  <app.dataaccess>
    <appdatabase id="MySQL" type="Bosco.DAO.MySQL.MySQLDataHandler, Bosco.DAO"/>
  </app.dataaccess>


  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network">
        <network host="smtp.gmail.com" port="587" userName="acmeerpportal@gmail.com" password="johnbritto" defaultCredentials="false" enableSsl="true"/>
      </smtp>
    </mailSettings>
  </system.net>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>

  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IDataSynchronizer" maxReceivedMessageSize="2147483647" />
      </basicHttpBinding>
    </bindings>
    <!--<client>
      <endpoint address="http://localhost/AcmePortal/DataSyncService/DataSynchronizer.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IDataSynchronizer"
        contract="DataSyncService.IDataSynchronizer" name="BasicHttpBinding_IDataSynchronizer" />
    </client>-->

    <client>
      <endpoint address="http://localhost:13569/DataSyncService/DataSynchronizer.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IDataSynchronizer"
        contract="DataSyncService.IDataSynchronizer" name="BasicHttpBinding_IDataSynchronizer" />
    </client>
  </system.serviceModel>
</configuration>

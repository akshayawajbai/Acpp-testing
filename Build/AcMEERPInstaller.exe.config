<?xml version="1.0"?>
<configuration>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IDataSynchronizer" maxBufferPoolSize="524288" maxReceivedMessageSize="6553600"/>
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost/ERP/DataSyncService/DataSynchronizer.svc" binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IDataSynchronizer" contract="DataSyncService.IDataSynchronizer" name="BasicHttpBinding_IDataSynchronizer"/>
    </client>
  </system.serviceModel>
<startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/></startup></configuration>

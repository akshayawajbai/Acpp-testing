<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="app.dataaccess" type="Payroll.DAO.Configuration.DatabaseHandler, Payroll.DAO"/>
  </configSections>

  <connectionStrings>
    <add name="AppConnectionString" connectionString="server=localhost;port=3307;database=msbpayroll;uid=root;pwd=acperproot;pooling=false" providerName="MySQL.Data.MySqlClient"/>
  </connectionStrings>


  <!--This value should be mapped in app.dataaccess to identify what type of Database Handler-->
  <!--It has to be declared as Enum Type in Payroll.Utility.EnumCommand.AppSettingName-->
  <appSettings>
    <!--<add key="DatabaseProvider" value="SQLServer"/>-->
    <add key="DatabaseProvider" value="MySQL"/>
    <add key="SQLAdapter" value="Payroll.SQL.SQLAdapter,Payroll.SQL"/>
  </appSettings>

  <!--Which is defined in configSections to be implemented here to access Data object (SQL Server/MySQL/....)-->
  <app.dataaccess>
    <appdatabase id="MySQL" type="Payroll.DAO.MySQL.MySQLDataHandler, Payroll.DAO"/>
  </app.dataaccess>

  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network">
        <network host="10.11.11.82" userName="" password="" defaultCredentials="true"/>
      </smtp>
    </mailSettings>
  </system.net>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="EnvDTE" publicKeyToken="B03F5F7F11D50A3A" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Services" publicKeyToken="B03F5F7F11D50A3A" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-4.0.0.0" newVersion="4.0.0.0"/>
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
</configuration>

<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="app.dataaccess" type="Bosco.DAO.Configuration.DatabaseHandler, Bosco.DAO"/>
  </configSections>

  
  <connectionStrings configProtectionProvider="RsaProtectedConfigurationProvider">
    <EncryptedData Type="http://www.w3.org/2001/04/xmlenc#Element"
      xmlns="http://www.w3.org/2001/04/xmlenc#">
      <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#tripledes-cbc" />
      <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
        <EncryptedKey xmlns="http://www.w3.org/2001/04/xmlenc#">
          <EncryptionMethod Algorithm="http://www.w3.org/2001/04/xmlenc#rsa-1_5" />
          <KeyInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
            <KeyName>Rsa Key</KeyName>
          </KeyInfo>
          <CipherData>
            <CipherValue></CipherValue>
          </CipherData>
        </EncryptedKey>
      </KeyInfo>
      <CipherData>
        <CipherValue></CipherValue>
      </CipherData>
    </EncryptedData>
  </connectionStrings>


  <!--This value should be mapped in app.dataaccess to identify what type of Database Handler-->
  <!--It has to be declared as Enum Type in Bosco.Utility.EnumCommand.AppSettingName-->
  <appSettings>
    <add key="DatabaseProvider" value="MySQL" />
    <add key="SQLAdapter" value="Bosco.SQL.SQLAdapter,Bosco.SQL" />
    <add key="HOSQLAdapter" value="Bosco.HOSQL.SQLAdapter,Bosco.HOSQL" />
    <add key="PayrollSQLAdapter" value="Payroll.SQL.SQLAdapter,Payroll.SQL" />
    <add key="OleDBConFormat" value="Provider=Microsoft.Jet.OLEDB.4.0;data source=@AccessDB@" />
    <add key="OleDBConStr" />
    <add key="TallyServer" value="localhost" />
    <add key="Port" value="9000" />
    <add key="ftpURL" value="httpdocs/Module/Software/Uploads/" />
    <add key="version" value="1.7.0" />
    <add key="CristoSQLAdapter" value="Cristo.SQL.SQLAdapter,Cristo.SQL" />
  </appSettings>


  <!--Which is defined in configSections to be implemented here to access Data object (SQL Server/MySQL/....)-->
  <app.dataaccess>
    <appdatabase id="MySQL" type="Bosco.DAO.MySQL.MySQLDataHandler, Bosco.DAO"/>
  </app.dataaccess>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network">
        <network host="10.11.11.82" userName="" password="" defaultCredentials="true"/>
      </smtp>
    </mailSettings>
  </system.net>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>

  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IAcMEService" closeTimeout="00:05:00"
          openTimeout="00:05:00" receiveTimeout="00:20:00" sendTimeout="00:20:00"
          maxBufferSize="524288" maxReceivedMessageSize="524288">
          <readerQuotas maxDepth="32" maxStringContentLength="524288" maxArrayLength="16384"
            maxBytesPerRead="4096" maxNameTableCharCount="16384" />
        </binding>
        <binding name="BasicHttpBinding_IDataSynchronizer" closeTimeout="00:40:00"
          openTimeout="00:40:00" receiveTimeout="00:40:00" sendTimeout="00:40:00"
          maxBufferPoolSize="2147483647" maxBufferSize="2147483647" maxReceivedMessageSize="2147483647" />
      </basicHttpBinding>
    </bindings>
    <services>
      <service name="AcMEService.AcMeERPService" behaviorConfiguration="mexBehavior">
        <endpoint address="AcMeERPService" binding="basicHttpBinding" contract="AcMEService.IAcMeERPService" bindingConfiguration="BasicHttpBinding_IAcMEService">
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange"/>
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8098/AcMEService"/>
          </baseAddresses>
        </host>
      </service>
    </services>

    <behaviors>
      <serviceBehaviors>
        <behavior name="mexBehavior">
          <serviceMetadata httpGetEnabled="true"/>
          <dataContractSerializer maxItemsInObjectGraph="524288"/>
          <serviceDebug includeExceptionDetailInFaults="true"/>
        </behavior>
      </serviceBehaviors>
    </behaviors>

    <client>
      <endpoint address="http://acmeerp.org/DataSyncService/DataSynchronizer.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IDataSynchronizer"
        contract="DataSyncService.IDataSynchronizer" name="BasicHttpBinding_IDataSynchronizer" />
    </client>
  </system.serviceModel>
 
</configuration>

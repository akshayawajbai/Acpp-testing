<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="app.dataaccess" type="Bosco.DAO.Configuration.DatabaseHandler, Bosco.DAO" />
  </configSections>
  <connectionStrings>
    <!--<add name="AppConnectionString" connectionString="server=localhost;connection timeout=300; database=acperp;uid=root;pwd=acperproot;pooling=false" providerName="MySQL.Data.MySqlClient"/>-->
    <add name="AppConnectionString" connectionString="server=localhost; port=3306;database=acperp; uid=root;pwd=acperproot; charset=utf8; pooling=false" providerName="MySQL.Data.MySqlClient" />
    <add name="MySQLConnectionString" connectionString="server=localhost; port=3306;database=mysql;uid=root;pwd=acperproot; charset=utf8; pooling=false" providerName="MySQL.Data.MySqlClient" />
  </connectionStrings>
  <!--This value should be mapped in app.dataaccess to identify what type of Database Handler-->
  <!--It has to be declared as Enum Type in Bosco.Utility.EnumCommand.AppSettingName-->
  <appSettings>
    <!--<add key="DatabaseProvider" value="SQLServer"/>-->
    <add key="DatabaseProvider" value="MySQL" />
    <add key="SQLAdapter" value="Bosco.SQL.SQLAdapter,Bosco.SQL" />
    <add key="HOSQLAdapter" value="Bosco.HOSQL.SQLAdapter,Bosco.HOSQL" />
    <add key="PayrollSQLAdapter" value="Payroll.SQL.SQLAdapter,Payroll.SQL" />
    <add key="CristoSQLAdapter" value="Cristo.SQL.SQLAdapter,Cristo.SQL" />
    <!--For AcMePlus Migration purpose -->
    <add key="OleDBConFormat" value="Provider=Microsoft.Jet.OLEDB.4.0;data source=@AccessDB@" />
    <!--For Tally Migration -->
    <add key="TallyServer" value="localhost" />
    <add key="Port" value="9000" />
    <add key="version" value="1.0.0" />
    <!-- If Multilocation enabled, The Folder locdation will be used-->
    <add key="DataSyncLocation" value="D:\AcME_ERP_Vouchers" />
    <add key="TDSLogPath" value="D:\AcMEERP_Vouchers\TDSTransLog.txt" />
    <add key="DefaultSenderEmailId" value="acmeerp@boscosofttech.com" />
    <add key="DefaultBCCEmailId" value="acmeerp@boscosofttech.com" />
    <add key="OleDBConStr" value="" />
    <add key="TDSTaxRate" value="20" />
    <add key="ftpURL" value="httpdocs/Module/Software/Uploads/" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <!--Which is defined in configSections to be implemented here to access Data object (SQL Server/MySQL/....)-->
  <app.dataaccess>
    <appdatabase id="MySQL" type="Bosco.DAO.MySQL.MySQLDataHandler, Bosco.DAO" />
  </app.dataaccess>
  <system.net>
    <mailSettings>
      <smtp deliveryMethod="Network">
        <network host="smtp.gmail.com" port="587" userName="acmeerpportal@gmail.com" password="johnbritto" defaultCredentials="false" enableSsl="true" />
      </smtp>
    </mailSettings>
  </system.net>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="EnvDTE" publicKeyToken="B03F5F7F11D50A3A" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-8.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IAcMEService" closeTimeout="00:05:00"
          openTimeout="00:05:00" receiveTimeout="00:20:00" sendTimeout="00:20:00"
          allowCookies="false" bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard"
          maxBufferPoolSize="524288" maxBufferSize="524288" maxReceivedMessageSize="524288"
          textEncoding="utf-8" transferMode="Buffered" useDefaultWebProxy="true"
          messageEncoding="Text">
          <readerQuotas maxDepth="32" maxStringContentLength="524288" maxArrayLength="16384"
            maxBytesPerRead="4096" maxNameTableCharCount="16384" />
        </binding>
        <binding name="BasicHttpBinding_IDataSynchronizer" closeTimeout="00:05:00"
          openTimeout="00:10:00" receiveTimeout="00:10:00" sendTimeout="00:20:00"
          maxReceivedMessageSize="2147483646" />
      </basicHttpBinding>
    </bindings>
    <services>
      <service name="AcMEService.AcMeERPService" behaviorConfiguration="mexBehavior">
        <endpoint address="AcMeERPService" binding="basicHttpBinding" contract="AcMEService.IAcMeERPService" bindingConfiguration="BasicHttpBinding_IAcMEService">
        </endpoint>
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
        <host>
          <baseAddresses>
            <add baseAddress="http://localhost:8098/AcMEService" />
          </baseAddresses>
        </host>
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior name="mexBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <dataContractSerializer maxItemsInObjectGraph="524288" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>

      </serviceBehaviors>
    </behaviors>
    <client>
      <endpoint address="http://acmeerp.org/DataSyncService/DataSynchronizer.svc"
        binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IDataSynchronizer"
        contract="DataSyncService.IDataSynchronizer" name="BasicHttpBinding_IDataSynchronizer" />
    </client>
  </system.serviceModel>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>